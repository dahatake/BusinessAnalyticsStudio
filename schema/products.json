{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "createdBy": {
            "type": "string",
            "enum": [
              "ai",
              "human",
              "sample"
            ]
          },
          "classification": {
            "type": "string",
            "enum": [
              "internal",
              "shareable"
            ]
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "vendor": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "number"
                },
                "unit": {
                  "type": "string"
                },
                "stages": {
                  "type": "object",
                  "properties": {
                    "boundaries": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "number"
                        }
                      ],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "betterWhen": {
                      "type": "string",
                      "enum": [
                        "high",
                        "low"
                      ]
                    }
                  },
                  "required": [
                    "boundaries"
                  ],
                  "additionalProperties": {}
                },
                "sourceIds": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]*$"
                  }
                }
              },
              "required": [
                "label",
                "value",
                "sourceIds"
              ],
              "additionalProperties": {}
            }
          }
        },
        "required": [
          "id",
          "createdBy",
          "name"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "products"
  ],
  "additionalProperties": {}
}
