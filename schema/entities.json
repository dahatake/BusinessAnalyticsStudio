{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "createdBy": {
            "type": "string",
            "enum": [
              "ai",
              "human",
              "sample"
            ]
          },
          "classification": {
            "type": "string",
            "enum": [
              "internal",
              "shareable"
            ]
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "parentId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "location": {
            "type": "object",
            "properties": {
              "lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "lng": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            },
            "required": [
              "lat",
              "lng"
            ],
            "additionalProperties": {}
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "number"
                },
                "unit": {
                  "type": "string"
                },
                "sourceIds": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]*$"
                  }
                }
              },
              "required": [
                "label",
                "value",
                "sourceIds"
              ],
              "additionalProperties": {}
            }
          }
        },
        "required": [
          "id",
          "createdBy",
          "type",
          "name"
        ],
        "additionalProperties": {}
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "createdBy": {
            "type": "string",
            "enum": [
              "ai",
              "human",
              "sample"
            ]
          },
          "classification": {
            "type": "string",
            "enum": [
              "internal",
              "shareable"
            ]
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          "from": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string"
          },
          "volume": {
            "type": "number",
            "minimum": 0
          },
          "unit": {
            "type": "string"
          },
          "peakHour": {
            "type": "number",
            "minimum": 0,
            "maximum": 23
          }
        },
        "required": [
          "id",
          "createdBy",
          "from",
          "to",
          "label"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "entities"
  ],
  "additionalProperties": {}
}
