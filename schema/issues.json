{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "createdBy": {
            "type": "string",
            "enum": [
              "ai",
              "human",
              "sample"
            ]
          },
          "classification": {
            "type": "string",
            "enum": [
              "internal",
              "shareable"
            ]
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          "parentId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "hypothesis": {
            "type": "string"
          },
          "origin": {
            "type": "string"
          },
          "audience": {
            "type": "string",
            "enum": [
              "internal",
              "external"
            ]
          },
          "personas": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evaluation": {
            "type": "object",
            "properties": {
              "priority": {
                "type": "object",
                "properties": {
                  "value": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "string",
                        "minLength": 1
                      }
                    ]
                  },
                  "unit": {
                    "type": "string"
                  },
                  "sourceIds": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]*$"
                    }
                  }
                },
                "required": [
                  "value",
                  "sourceIds"
                ],
                "additionalProperties": {}
              },
              "cost": {
                "type": "object",
                "properties": {
                  "value": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "string",
                        "minLength": 1
                      }
                    ]
                  },
                  "unit": {
                    "type": "string"
                  },
                  "sourceIds": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]*$"
                    }
                  }
                },
                "required": [
                  "value",
                  "sourceIds"
                ],
                "additionalProperties": {}
              },
              "roi": {
                "type": "object",
                "properties": {
                  "value": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "string",
                        "minLength": 1
                      }
                    ]
                  },
                  "unit": {
                    "type": "string"
                  },
                  "sourceIds": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]*$"
                    }
                  }
                },
                "required": [
                  "value",
                  "sourceIds"
                ],
                "additionalProperties": {}
              },
              "feasibility": {
                "type": "object",
                "properties": {
                  "value": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "string",
                        "minLength": 1
                      }
                    ]
                  },
                  "unit": {
                    "type": "string"
                  },
                  "sourceIds": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]*$"
                    }
                  }
                },
                "required": [
                  "value",
                  "sourceIds"
                ],
                "additionalProperties": {}
              },
              "risk": {
                "type": "object",
                "properties": {
                  "value": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "string",
                        "minLength": 1
                      }
                    ]
                  },
                  "unit": {
                    "type": "string"
                  },
                  "sourceIds": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]*$"
                    }
                  }
                },
                "required": [
                  "value",
                  "sourceIds"
                ],
                "additionalProperties": {}
              }
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "id",
          "createdBy",
          "title",
          "audience"
        ],
        "additionalProperties": {}
      }
    },
    "solutions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "createdBy": {
            "type": "string",
            "enum": [
              "ai",
              "human",
              "sample"
            ]
          },
          "classification": {
            "type": "string",
            "enum": [
              "internal",
              "shareable"
            ]
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          "issueId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "productIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          "productFits": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "productId": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "productId",
                "reason"
              ],
              "additionalProperties": {}
            }
          }
        },
        "required": [
          "id",
          "createdBy",
          "issueId",
          "title"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "issues",
    "solutions"
  ],
  "additionalProperties": {}
}
