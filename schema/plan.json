{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "createdBy": {
            "type": "string",
            "enum": [
              "ai",
              "human",
              "sample"
            ]
          },
          "classification": {
            "type": "string",
            "enum": [
              "internal",
              "shareable"
            ]
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "issueIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          }
        },
        "required": [
          "id",
          "createdBy",
          "title"
        ],
        "additionalProperties": {}
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "createdBy": {
            "type": "string",
            "enum": [
              "ai",
              "human",
              "sample"
            ]
          },
          "classification": {
            "type": "string",
            "enum": [
              "internal",
              "shareable"
            ]
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "featureId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "parentId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "work": {
            "type": "string",
            "minLength": 1
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          }
        },
        "required": [
          "id",
          "createdBy",
          "title"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "features",
    "tasks"
  ],
  "additionalProperties": {}
}
