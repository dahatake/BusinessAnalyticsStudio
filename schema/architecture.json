{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "createdBy": {
            "type": "string",
            "enum": [
              "ai",
              "human",
              "sample"
            ]
          },
          "classification": {
            "type": "string",
            "enum": [
              "internal",
              "shareable"
            ]
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "layer": {
            "type": "string"
          },
          "productId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "required": [
          "id",
          "createdBy",
          "label"
        ],
        "additionalProperties": {}
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "createdBy": {
            "type": "string",
            "enum": [
              "ai",
              "human",
              "sample"
            ]
          },
          "classification": {
            "type": "string",
            "enum": [
              "internal",
              "shareable"
            ]
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          "from": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "createdBy",
          "from",
          "to"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "nodes",
    "edges"
  ],
  "additionalProperties": {}
}
