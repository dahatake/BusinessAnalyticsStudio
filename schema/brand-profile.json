{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "primaryColor": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "logo": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "primaryColor"
  ],
  "additionalProperties": {}
}
