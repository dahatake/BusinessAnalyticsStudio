{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "colors": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "retrievedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "confidence": {
          "type": "string",
          "enum": [
            "高",
            "中",
            "低",
            "推定"
          ]
        },
        "primary": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "required": [
        "source",
        "retrievedAt",
        "confidence",
        "primary"
      ],
      "additionalProperties": {}
    },
    "logo": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "retrievedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "confidence": {
          "type": "string",
          "enum": [
            "高",
            "中",
            "低",
            "推定"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "confirmed",
            "unknown"
          ]
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "retrievedAt",
        "confidence",
        "status"
      ],
      "additionalProperties": {}
    },
    "fonts": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "retrievedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "confidence": {
          "type": "string",
          "enum": [
            "高",
            "中",
            "低",
            "推定"
          ]
        },
        "primary": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source",
        "retrievedAt",
        "confidence",
        "primary"
      ],
      "additionalProperties": {}
    },
    "tone": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "retrievedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "confidence": {
          "type": "string",
          "enum": [
            "高",
            "中",
            "低",
            "推定"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source",
        "retrievedAt",
        "confidence",
        "value"
      ],
      "additionalProperties": {}
    }
  },
  "required": [
    "name",
    "colors",
    "logo",
    "fonts",
    "tone"
  ],
  "additionalProperties": {}
}
