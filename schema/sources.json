{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "createdBy": {
            "type": "string",
            "enum": [
              "ai",
              "human",
              "sample"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "web",
              "workiq",
              "document",
              "interview",
              "sample"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string"
          },
          "retrievedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "高",
              "中",
              "低",
              "推定"
            ]
          },
          "classification": {
            "type": "string",
            "enum": [
              "internal",
              "shareable"
            ]
          }
        },
        "required": [
          "id",
          "createdBy",
          "kind",
          "title",
          "retrievedAt",
          "confidence"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "sources"
  ],
  "additionalProperties": {}
}
