{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "projectName": {
      "type": "string",
      "minLength": 1
    },
    "templateVersion": {
      "type": "string",
      "minLength": 1
    },
    "locale": {
      "default": "ja",
      "type": "string"
    },
    "industryPreset": {
      "type": "string"
    },
    "createdBy": {
      "type": "string",
      "enum": [
        "ai",
        "human",
        "sample"
      ]
    },
    "coreObject": {
      "type": "object",
      "properties": {
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "summary": {
                "type": "string"
              },
              "scores": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": {}
          }
        },
        "selectedId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": {}
          }
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "candidates"
      ],
      "additionalProperties": {}
    },
    "glossary": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "term",
          "definition"
        ],
        "additionalProperties": {}
      }
    },
    "okr": {
      "type": "object",
      "properties": {
        "updatedAt": {
          "type": "string",
          "minLength": 1
        },
        "objectives": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "objective": {
                "type": "string",
                "minLength": 1
              },
              "keyResults": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]*$"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "solutionIds": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9-]*$"
                      }
                    },
                    "kpi": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "unit": {
                          "type": "string",
                          "minLength": 1
                        },
                        "baseline": {
                          "type": "number"
                        },
                        "current": {
                          "type": "number"
                        },
                        "target": {
                          "type": "number"
                        },
                        "due": {
                          "type": "string"
                        },
                        "stages": {
                          "type": "object",
                          "properties": {
                            "boundaries": {
                              "type": "array",
                              "prefixItems": [
                                {
                                  "type": "number"
                                },
                                {
                                  "type": "number"
                                }
                              ],
                              "items": false,
                              "minItems": 2,
                              "maxItems": 2
                            },
                            "betterWhen": {
                              "type": "string",
                              "enum": [
                                "high",
                                "low"
                              ]
                            }
                          },
                          "required": [
                            "boundaries"
                          ],
                          "additionalProperties": {}
                        }
                      },
                      "required": [
                        "name",
                        "unit",
                        "baseline",
                        "current",
                        "target"
                      ],
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "name",
                    "kpi"
                  ],
                  "additionalProperties": {}
                }
              }
            },
            "required": [
              "objective",
              "keyResults"
            ],
            "additionalProperties": {}
          }
        }
      },
      "required": [
        "objectives"
      ],
      "additionalProperties": {}
    },
    "useCases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "persona": {
            "type": "string",
            "enum": [
              "経営層",
              "事業部門",
              "IT",
              "現場"
            ]
          },
          "steps": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string"
                }
              },
              "required": [
                "title"
              ],
              "additionalProperties": {}
            }
          },
          "effect": {
            "type": "string",
            "minLength": 1
          },
          "solutionId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "kpiNames": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "name",
          "summary",
          "persona",
          "steps",
          "effect",
          "solutionId",
          "kpiNames"
        ],
        "additionalProperties": {}
      }
    },
    "fictionalNote": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "name",
    "projectName",
    "templateVersion",
    "createdBy",
    "coreObject"
  ],
  "additionalProperties": {}
}
