{
  "name": "enterprise-discussion-board",
  "private": true,
  "version": "0.1.0",
  "description": "ビジネス議論の分析ボード（顧客固有情報を持たない共通アプリ本体）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "gen:schema": "tsx scripts/gen-schema.ts",
    "check:pack": "tsx scripts/check-pack.ts"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.72.0",
    "@fluentui/react-icons": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
