{
  "name": "enterprise-discussion-board",
  "private": true,
  "version": "0.1.0",
  "description": "ビジネス議論の分析ボード（顧客固有情報を持たない共通アプリ本体）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite preview --host 127.0.0.1",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "relay": "tsx scripts/relay/start.ts",
    "gen:schema": "tsx scripts/gen-schema.ts",
    "check:pack": "tsx scripts/check-pack.ts",
    "pipeline": "tsx scripts/pipeline/cli.ts",
    "package": "tsx scripts/make-package.ts"
  },
  "dependencies": {
    "@fluentui/react-components": "9.74.9",
    "@fluentui/react-icons": "2.0.343",
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.18.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.171.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.171.0",
    "@vitejs/plugin-react": "4.7.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
